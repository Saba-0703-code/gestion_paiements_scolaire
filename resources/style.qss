QWidget {
    background-color: #F5F7FA;
    color: #263238;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

QPushButton {
    background-color: #1565C0;
    color: #FFFFFF;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: bold;
    min-width: 100px;
}
QPushButton:hover {
    background-color: #0D47A1;
}

QLineEdit, QTableWidget, QComboBox, QDateEdit {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    padding: 6px;
    border-radius: 4px;
}
QLineEdit:focus {
    border-color: #1565C0;
}

QHeaderView::section {
    background-color: #1565C0;
    color: #FFFFFF;
    padding: 8px;
    border: none;
    font-weight: bold;
}

QTableWidget {
    alternate-background-color: #FFFFFF;
    gridline-color: #E0E0E0;
}